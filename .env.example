# Local (Lando) settings. Copy to .env: `cp .env.example .env`
# config/application.php loads .env whenever it exists. It is gitignored, so it
# never reaches Pantheon, which injects its own DB credentials and salts.

WP_HOME=https://fixme-app-name.lndo.site
WP_SITEURL=${WP_HOME}/wp
WP_ENV=development

DB_NAME=pantheon
DB_USER=pantheon
DB_PASSWORD=pantheon
DB_HOST=database

# Optional database variables
# DB_PREFIX='wp_'

# Specify optional debug.log path starting from web root.
# WP_DEBUG_LOG='/app/debug.log'

# Generate your own keys: https://roots.io/salts.html
AUTH_KEY=generateme
SECURE_AUTH_KEY=generateme
LOGGED_IN_KEY=generateme
NONCE_KEY=generateme
AUTH_SALT=generateme
SECURE_AUTH_SALT=generateme
LOGGED_IN_SALT=generateme
NONCE_SALT=generateme

# Sage / Vite dev server (laravel-vite-plugin reads APP_URL)
APP_URL=${WP_HOME}

# Premium plugin licenses. Locally, OCP_LICENSE falls back to auth.json.
# On Pantheon these are site secrets (type runtime, scope web):
#   terminus secret:site:set <site> <KEY> <value> --type=runtime --scope=web
ACF_PRO_LICENSE=
ACP_LICENCE=
OCP_LICENSE=

# Premium plugins without a Composer registry (junaidbhura/composer-wp-pro-plugins)
# read their keys at `composer install`. Not in use yet (see README).
# ACFE_PRO_KEY=
# ACFE_PRO_URL=www.threespot.com
# SEARCHWP_LICENSE_KEY=
# FACETWP_LICENSE_KEY=

# Live only: 301 to this host when set (Pantheon Secret on the live site).
# PRIMARY_DOMAIN=www.example.org
