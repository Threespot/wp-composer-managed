{
  "name": "sage",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "browserslist": [
    "> 0.5% in US",
    "last 1 Android major versions",
    "last 2 ChromeAndroid major versions",
    "last 2 Chrome major versions",
    "last 2 Firefox major versions",
    "last 2 Safari major versions",
    "last 2 iOS major versions"
  ],
  "type": "module",
  "scripts": {
    "start": "NODE_OPTIONS=--preserve-symlinks vite",
    "build": "NODE_OPTIONS=--preserve-symlinks vite build",
    "translate": "npm run translate:pot && npm run translate:update",
    "translate:pot": "wp i18n make-pot . ./resources/lang/sage.pot --include=\"theme.json,patterns,app,resources\"",
    "translate:update": "for file in ./resources/lang/*.po; do wp i18n update-po ./resources/lang/sage.pot $file; done",
    "translate:compile": "npm run translate:mo && npm run translate:js",
    "translate:js": "wp i18n make-json ./resources/lang --pretty-print",
    "translate:mo": "wp i18n make-mo ./resources/lang ./resources/lang",
    "lint:css": "NODE_OPTIONS=--preserve-symlinks stylelint \"resources/**/*.{css,scss}\"",
    "lint:js": "NODE_OPTIONS=--preserve-symlinks eslint \"resources/scripts/**/*.{js,jsx}\""
  },
  "dependencies": {
    "@threespot/expand-toggle": "^4.0.0",
    "@threespot/wp-base-styles": "https://github.com/Threespot/wp-base-styles.git#semver:^0.1.0",
    "frontline-css-reset": "^8.0.1",
    "frontline-sass": "^6.0.1",
    "vite-plugin-mkcert": "^2.1.0",
    "what-input": "^5.2.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@roots/vite-plugin": "^2.2.0",
    "browserslist": "^4.28.8",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "laravel-vite-plugin": "^3.2.0",
    "lightningcss": "^1.33.0",
    "postcss": "^8.5.26",
    "postcss-preset-env": "^11.5.0",
    "postcss-pxtorem": "^6.1.0",
    "postcss-safe-parser": "^7.0.1",
    "sass": "^1.103.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.2.0",
    "vite": "^8.2.2",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-plugin-stylelint": "^6.3.0",
    "vite-plugin-svg-icons": "^2.0.1"
  },
  "packageManager": "yarn@4.14.1"
}
