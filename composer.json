{
    "name": "threespot/fixme-app-name",
    "type": "project",
    "license": "proprietary",
    "description": "fixme-project-name: Composer-managed WordPress on Pantheon (Threespot wp-composer-managed upstream).",
    "homepage": "https://github.com/Threespot/fixme-app-name",
    "repositories": [
        {
            "type": "composer",
            "url": "https://composer.admincolumns.com"
        },
        {
            "type": "composer",
            "url": "https://composer.gravity.io"
        },
        {
            "type": "composer",
            "url": "https://connect.advancedcustomfields.com"
        },
        {
            "type": "composer",
            "url": "https://gravitywiz.com/composer"
        },
        {
            "type": "composer",
            "url": "https://objectcache.pro/repo/"
        },
        {
            "type": "composer",
            "url": "https://repo.wp-packages.org",
            "only": [
                "wp-plugin/*",
                "wp-theme/*"
            ]
        },
        {
            "type": "path",
            "url": "upstream-configuration"
        },
        {
            "type": "vcs",
            "url": "https://github.com/threespot/wp-base-config"
        },
        {
            "type": "vcs",
            "url": "https://github.com/threespot/wp-fixtures"
        },
        {
            "type": "package",
            "package": {
                "name": "junaidbhura/acf-extended-pro",
                "version": "0.9.2.8",
                "type": "wordpress-plugin",
                "dist": {
                    "type": "zip",
                    "url": "https://www.acf-extended.com/"
                },
                "require": {
                    "junaidbhura/composer-wp-pro-plugins": "*"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "junaidbhura/wp-all-export-pro",
                "version": "2.0.1",
                "type": "wordpress-plugin",
                "dist": {
                    "type": "zip",
                    "url": "https://www.wpallimport.com/"
                },
                "require": {
                    "junaidbhura/composer-wp-pro-plugins": "*"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "junaidbhura/wp-all-import-pro",
                "version": "6.0.1",
                "type": "wordpress-plugin",
                "dist": {
                    "type": "zip",
                    "url": "https://www.wpallimport.com/"
                },
                "require": {
                    "junaidbhura/composer-wp-pro-plugins": "*"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "junaidbhura/wpae-acf-add-on",
                "version": "2.0.0",
                "type": "wordpress-plugin",
                "dist": {
                    "type": "zip",
                    "url": "https://www.wpallimport.com/"
                },
                "require": {
                    "junaidbhura/composer-wp-pro-plugins": "*"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "junaidbhura/wpai-acf-add-on",
                "version": "4.0.2",
                "type": "wordpress-plugin",
                "dist": {
                    "type": "zip",
                    "url": "https://www.wpallimport.com/"
                },
                "require": {
                    "junaidbhura/composer-wp-pro-plugins": "*"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "junaidbhura/wpai-user-add-on",
                "version": "2.0.0",
                "type": "wordpress-plugin",
                "dist": {
                    "type": "zip",
                    "url": "https://www.wpallimport.com/"
                },
                "require": {
                    "junaidbhura/composer-wp-pro-plugins": "*"
                }
            }
        }
    ],
    "require": {
        "composer/installers": "^2.2",
        "cweagans/composer-patches": "^1.7",
        "oscarotero/env": "^2.1",
        "pantheon-systems/pantheon-mu-plugin": "^1.5.6",
        "pantheon-upstreams/upstream-configuration": "dev-main",
        "php": ">=8.3",
        "roots/bedrock-autoloader": "^1.0",
        "roots/bedrock-disallow-indexing": "^2.0",
        "roots/wordpress": "~7.1.3",
        "roots/wp-config": "^1.0.0",
        "vlucas/phpdotenv": "^5.5",
        "wp-plugin/pantheon-advanced-page-cache": "^2.0",
        "wp-plugin/wp-native-php-sessions": "^1.2"
    },
    "require-dev": {
        "assertwell/shellcheck": "^1.0",
        "brain/monkey": "^2.6",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "pantheon-systems/pantheon-wp-coding-standards": "^3.0",
        "php-stubs/acf-pro-stubs": "^6.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5",
        "roave/security-advisories": "dev-latest",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "threespot/wp-fixtures": "^0.1.8"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "process-timeout": 0,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "junaidbhura/composer-wp-pro-plugins": true,
            "phpstan/extension-installer": true,
            "roots/acorn": true,
            "roots/wordpress-core-installer": true
        },
        "sort-packages": true,
        "platform": {
            "php": "8.3.36",
            "ext-redis": "5.3.7"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "installer-paths": {
            "web/app/mu-plugins/{$name}/": [
                "type:wordpress-muplugin"
            ],
            "web/app/plugins/{$name}/": [
                "type:wordpress-plugin"
            ],
            "web/app/themes/{$name}/": [
                "type:wordpress-theme"
            ]
        },
        "wordpress-install-dir": "web/wp",
        "build-env": {
            "install-cms": [
                "wp core install --title={site-name} --url={site-url} --admin_user={account-name} --admin_email={account-mail} --admin_password={account-pass}",
                "wp option update permalink_structure '/%postname%/'"
            ]
        },
        "composer-scaffold": {
            "locations": {
                "web-root": "./"
            }
        },
        "composer-exit-on-patch-failure": true,
        "enable-patching": true
    },
    "autoload": {
        "classmap": [
            "upstream-configuration/scripts/ComposerScripts.php"
        ]
    },
    "scripts": {
        "post-install-cmd": [
            "@maybe-create-symlinks",
            "@theme:install"
        ],
        "pre-update-cmd": [
            "WordPressComposerManaged\\ComposerScripts::preUpdate"
        ],
        "maybe-create-symlinks": [
            "bash ./private/scripts/helpers.sh maybe_create_symlinks"
        ],
        "lint:bash": [
            "shellcheck private/scripts/*.sh"
        ],
        "theme:install": "@composer install --no-dev --prefer-dist --optimize-autoloader --no-interaction --working-dir=web/app/themes/sage",
        "theme:dev": [
            "Composer\\Config::disableProcessTimeout",
            "cd web/app/themes/sage && npm run dev"
        ],
        "theme:build": [
            "Composer\\Config::disableProcessTimeout",
            "cd web/app/themes/sage && npm ci && npm run build"
        ],
        "deploy:test": "terminus env:deploy fixme-app-name.test && terminus env:clear-cache fixme-app-name.test",
        "deploy:live": "terminus env:deploy fixme-app-name.live && terminus env:clear-cache fixme-app-name.live",
        "post-update-cmd": [
            "WordPressComposerManaged\\ComposerScripts::postUpdate",
            "@maybe-create-symlinks"
        ],
        "lint": "git ls-files -z 'web/app/*.php' ':!:web/app/plugins/*' | xargs -0 -P4 -n1 php -l",
        "phpcs": [
            "./vendor/bin/phpcs"
        ],
        "phpcbf": [
            "./vendor/bin/phpcbf"
        ],
        "phpstan": [
            "./vendor/bin/phpstan analyse --memory-limit=1G"
        ],
        "unit-test": [
            "./vendor/bin/phpunit"
        ],
        "ci": [
            "@lint",
            "@phpcs",
            "@phpstan",
            "@unit-test"
        ],
        "collect-logs": [
            "./logs/collect-logs-rsync.sh"
        ],
        "deploy:all": "terminus env:deploy fixme-app-name.test && terminus env:clear-cache fixme-app-name.test && terminus env:deploy fixme-app-name.live && terminus env:clear-cache fixme-app-name.live",
        "replace-fixme": "php scripts/replace-fixme.php"
    },
    "scripts-descriptions": {
        "theme:install": "Install the Sage theme Composer dependencies (runs after every root install, including Pantheon Integrated Composer).",
        "deploy:test": "Promote Dev to Test and clear the Test cache.",
        "deploy:live": "Promote Test to Live and clear the Live cache.",
        "ci": "Run every static check CI runs: php -l, phpcs, phpstan, phpunit.",
        "replace-fixme": "Replace fixme-app-name / fixme-project-name / fixme-domain / FIXME_pantheon_site_id with this site's values (pass --app, --name, --domain)."
    },
    "autoload-dev": {
        "psr-4": {
            "Threespot\\Tests\\": "tests/"
        }
    }
}
